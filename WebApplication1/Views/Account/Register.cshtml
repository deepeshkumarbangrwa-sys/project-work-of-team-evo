@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>Register - Graphene Trace</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card shadow p-4" style="width: 500px;">
        <h3 class="text-center mb-4 text-primary"><i class="fa-solid fa-user-plus"></i> Register New User</h3>
        
        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label>Full Name</label>
                <input name="fullName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Email (Used for Login)</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            
            <label class="mb-2">Registering as:</label>
            <div class="d-flex gap-3 mb-3">
                <button type="submit" name="role" value="Patient" class="btn btn-outline-primary w-100">
                    <i class="fa-solid fa-user"></i> Patient
                </button>
                <button type="submit" name="role" value="Clinician" class="btn btn-outline-success w-100">
                    <i class="fa-solid fa-user-doctor"></i> Clinician
                </button>
            </div>
        </form>
        
        <div class="mt-3 text-center">
            <a asp-action="Login">Already have an account? Log In</a>
        </div>
    </div>
</body>
</html>