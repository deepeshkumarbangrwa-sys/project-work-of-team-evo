@model List<string>

<h2>Feedback Thread (Frame ID: @ViewBag.FrameID)</h2>
<hr />

<div class="mb-4">
    <h4>Conversation History</h4>
    <ul class="list-group">
        @foreach (var comment in Model)
        {
            <li class="list-group-item">@comment</li>
        }
    </ul>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3">
            <h5>Patient Feedback (P-4)</h5>
            <form asp-action="SubmitComment" method="post">
                <input type="hidden" name="frameId" value="@ViewBag.FrameID" />
                <textarea name="commentText" class="form-control mb-2" placeholder="Describe pain..."></textarea>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3">
            <h5>Clinician Reply (C-4)</h5>
            <form asp-action="SubmitReply" method="post">
                <input type="hidden" name="frameId" value="@ViewBag.FrameID" />
                <input type="hidden" name="parentCommentId" value="1" />
                <textarea name="replyText" class="form-control mb-2" placeholder="Clinical advice..."></textarea>
                <button type="submit" class="btn btn-warning">Reply</button>
            </form>
        </div>
    </div>
</div>