@model List<WebApplication1.Controllers.CommentModel>
@{ 
    string role = ViewBag.CurrentRole; 
    int pid = ViewBag.TargetPatientID; 
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-white shadow-sm rounded">
    <div>
        @if(role == "Clinician") { <a asp-action="ClinicianDashboard" class="btn btn-outline-secondary btn-sm">Back to List</a> }
        else { <a asp-action="PatientHome" class="btn btn-outline-secondary btn-sm">Home</a> }
        
        <a asp-controller="Report" asp-action="ViewReport" asp-route-patientId="@pid" class="btn btn-info btn-sm text-white ms-2">
            <i class="fa-solid fa-file-medical"></i> View Report
        </a>
    </div>
    <span class="badge bg-primary">Logged in as: @role</span>
</div>

<div class="chat-container bg-light p-3 border rounded mb-3" style="height: 400px; overflow-y: auto;">
    @if (!Model.Any()) { <p class="text-center text-muted mt-5">Start the conversation!</p> }
    @foreach (var msg in Model)
    {
        string align = msg.Role == "Patient" ? "start" : "end";
        string color = msg.Role == "Patient" ? "bg-white border" : "bg-success text-white";
        <div class="d-flex justify-content-@align mb-2">
            <div class="p-2 rounded @color" style="max-width: 75%;">
                <small class="d-block opacity-75">@msg.AuthorName - @msg.Timestamp.ToShortTimeString()</small>
                <div>@msg.Content</div>
            </div>
        </div>
    }
</div>

<form asp-action="SubmitMessage" method="post" class="d-flex gap-2">
    <input type="hidden" name="patientId" value="@pid" />
    <input name="content" class="form-control" placeholder="Type a message..." required />
    <button class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> Send</button>
</form>