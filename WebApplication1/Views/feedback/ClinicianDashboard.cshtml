@model List<WebApplication1.Controllers.PatientViewModel>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-4">
        <h2><i class="fa-solid fa-users"></i> Patient List</h2>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger">Log Out</a>
    </div>

    <form method="get" asp-action="ClinicianDashboard" class="mb-4">
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Search by Patient Name or ID..." />
            <button class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        </div>
    </form>

    <div class="list-group">
        @if (Model.Count == 0)
        {
            <div class="p-4 text-center text-muted">No active patients found.</div>
        }
        @foreach (var p in Model)
        {
            <a asp-action="ViewComments" asp-route-patientId="@p.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                <div>
                    <h5 class="mb-0">@p.Name</h5>
                    <small class="text-muted">Patient ID: @p.Id</small>
                </div>
                @if (p.NotificationCount > 0)
                {
                    <span class="badge bg-danger rounded-pill">@p.NotificationCount New Messages</span>
                }
                else
                {
                    <span class="badge bg-secondary rounded-pill">Up to date</span>
                }
            </a>
        }
    </div>
</div>