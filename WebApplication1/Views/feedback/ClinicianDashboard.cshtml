@model List<WebApplication1.Controllers.PatientViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-user-doctor"></i> Clinician Dashboard</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Log Out</a>
    </div>

    <form method="get" asp-action="ClinicianDashboard" class="mb-4">
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" name="search" class="form-control" placeholder="Search by Patient Name or ID..." />
            <button class="btn btn-primary">Search</button>
        </div>
    </form>

    <div class="list-group shadow-sm">
        @if (Model.Count == 0)
        {
            <div class="p-4 text-center text-muted">No patients found.</div>
        }

        @foreach (var p in Model)
        {
            <a asp-action="ViewComments" asp-route-patientId="@p.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">

                <div>
                    <h5 class="mb-1">@p.Name <small class="text-muted fs-6">(ID: @p.Id)</small></h5>
                    <small class="text-muted">Last Active: @p.LastActivity.ToString("g")</small>
                </div>

                @if (p.NotificationCount > 0)
                {
                    <span class="badge rounded-pill bg-danger">
                        @p.NotificationCount New Messages
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill bg-secondary">Up to date</span>
                }

                <i class="fa-solid fa-chevron-right ms-3 text-muted"></i>
            </a>
        }
    </div>
</div>