@{
    ViewData["Title"] = "Graphene Trace Login";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold">Graphene Trace</h1>
    <p class="lead text-muted">Sensore Pressure Monitoring System</p>
    <hr class="my-4" style="max-width: 50%; margin: auto;">

    <p>Please select a role to simulate the login process:</p>

    <div class="d-flex justify-content-center gap-4 mt-5">
        <a asp-controller="Home" asp-action="LoginSim" asp-route-role="Patient" class="btn btn-outline-primary btn-lg p-4 shadow-sm" style="min-width: 200px;">
            <i class="fa-solid fa-user fa-2x d-block mb-3"></i>
            <span class="d-block fw-bold">Patient Login</span>
            <small>John Doe (ID: 123)</small>
        </a>

        <a asp-controller="Home" asp-action="LoginSim" asp-route-role="Clinician" class="btn btn-outline-success btn-lg p-4 shadow-sm" style="min-width: 200px;">
            <i class="fa-solid fa-user-doctor fa-2x d-block mb-3"></i>
            <span class="d-block fw-bold">Clinician Login</span>
            <small>Dr. Smith (ID: 456)</small>
        </a>
    </div>

</div>